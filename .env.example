# Environment Configuration for Cc
#
# Copy this file to .env and update the values according to your setup.
# Never commit .env files to version control as they may contain sensitive data.
#
# Generated on 2025-09-05 using create-ai-spine-tool v1.0.0
# Template: , Language: typescript

# ===================================
# Server Configuration
# ===================================

# Port where the tool server will listen
PORT=

# Host address for the server (use 0.0.0.0 for all interfaces)
HOST=

# Environment (development, staging, production)
NODE_ENV=

# ===================================
# Logging and Debugging
# ===================================

# Log level (error, warn, info, debug)
LOG_LEVEL=

# Enable verbose logging for AI Spine operations
AI_SPINE_VERBOSE=

# Enable request logging in development
REQUEST_LOGGING=

# ===================================
# Security Configuration
# ===================================

# Enable API key authentication (true/false)
API_KEY_AUTH=

# Comma-separated list of valid API keys (only if API_KEY_AUTH=true)
VALID_API_KEYS=

# CORS origin (use * for all origins in development, specific URLs in production)
CORS_ORIGIN=

# ===================================
# Tool-Specific Configuration
# ===================================

# Basic Tool Configuration
DEFAULT_COUNT=
MAX_MESSAGE_LENGTH=


# ===================================
# Database Configuration (if applicable)
# ===================================

# DATABASE_URL=postgresql://user:password@localhost:5432/database
# REDIS_URL=redis://localhost:6379

# ===================================
# External Services
# ===================================

# Monitoring and observability
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# NEW_RELIC_LICENSE_KEY=your-new-relic-key

# Email service (if needed)
# SENDGRID_API_KEY=your-sendgrid-key
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password

# ===================================
# Performance and Scaling
# ===================================

# Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=

# Request timeout in milliseconds
REQUEST_TIMEOUT=

# Memory limit for the process (in MB)
MEMORY_LIMIT=

# Enable clustering (use CPU count or specific number)
CLUSTER_WORKERS=

# ===================================
# Development Tools
# ===================================

# Hot reload in development
HOT_RELOAD=

# Enable development features
DEV_FEATURES=

# Mock external services in development
MOCK_EXTERNAL_APIS=

# Script environment variables

GEMINI_API_KEY=
WEATHER_API_KEY=
SERVICE_URL=
SUPABASE_URL=
SUPABASE_KEY=
RAPID_API_KEY=
RAPID_API_HOST=
BASE_URL=
